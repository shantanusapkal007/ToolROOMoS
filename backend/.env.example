# =============================================================================
# ToolRoomOS Backend - Production Environment Configuration
# =============================================================================

# Application Server
NODE_ENV=production
PORT=4000
AUTO_MIGRATE=true

# Security & Access Control
# Generate a strong 64-char secret: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_production_secret
ALLOWED_ORIGINS=http://localhost:3000,https://app.yourdomain.com

# -----------------------------------------------------------------------------
# Database Layer (PostgreSQL / AWS RDS)
# -----------------------------------------------------------------------------
# Local Docker or EC2 Docker Compose:
DATABASE_URL=postgresql://root:rootpassword@postgres:5432/toolroomos?schema=public

# AWS RDS PostgreSQL (Uncomment and set for RDS deployment):
# DATABASE_URL=postgresql://dbadmin:YOUR_PASSWORD@your-rds-endpoint.rds.amazonaws.com:5432/toolroomos?schema=public&sslmode=require
# DB_SSL=true

# -----------------------------------------------------------------------------
# Cache Layer (Redis / AWS ElastiCache)
# -----------------------------------------------------------------------------
# Local Docker or EC2 Docker Compose:
REDIS_URL=redis://redis:6379

# AWS ElastiCache Redis (Cluster / Standalone):
# REDIS_URL=rediss://your-elasticache-cluster.cache.amazonaws.com:6379

# -----------------------------------------------------------------------------
# Object Storage Layer (MinIO or Native Amazon S3)
# -----------------------------------------------------------------------------
# OPTION A: Self-Hosted MinIO (Docker Compose / EC2):
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=replace_with_minio_password
MINIO_BUCKET=toolroomos-storage

# OPTION B: AWS Native Amazon S3 (ECS / Cloud):
# (Leave MINIO_ENDPOINT empty or commented to activate AWS S3 mode)
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-toolroomos-production-bucket
# AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
# (Note: On AWS ECS/EC2 with IAM Roles, AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY are optional)
